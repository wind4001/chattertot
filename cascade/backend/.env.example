# ============================================================
# LLM —— 可替换成任何 OpenAI 兼容端点（自部署也行）
# ============================================================
# llm.py 走的是 POST /chat/completions，所以下面三项指向谁就用谁：
#   DeepSeek 官方 : https://api.deepseek.com
#   自部署 vLLM   : http://localhost:8000/v1
#   Ollama        : http://localhost:11434/v1
#   LM Studio     : http://localhost:1234/v1
#   One-API 网关  : 你的网关地址
# 换端点时把 LLM_MODEL 填成对应模型名即可，代码不用动。
LLM_API_KEY=

# DeepSeek 官方 OpenAI 兼容接口（默认值，可改）
LLM_BASE_URL=https://api.deepseek.com

# 模型名：deepseek-v4-flash（别名 deepseek-flash）
LLM_MODEL=deepseek-v4-flash

# ============================================================
# TTS —— 可替换成自部署 TTS
# ============================================================
# tts.py 对外只暴露两个函数：
#   synthesize(text) -> bytes                   整段 mp3
#   synthesize_stream(text) -> AsyncIterator[bytes]  流式 24kHz 16bit PCM
# 换成 GPT-SoVITS / CosyVoice / Fish Speech / IndexTTS 等自部署方案时，
# 只需重写这两个函数，上层状态机、判停、打断逻辑都不用改。
#
# 下面三项是「豆包语音合成 2.0（seed-tts-2.0）」的配置（默认实现）。
#
# 注意：留空时 tts.py 会静默返回空音频（不抛错），表现为"AI 不说话"，
#       排查时先确认这个变量。
TTS_API_KEY=

# 音色，默认 zh_female_vv_uranus_bigtts
TTS_SPEAKER=zh_female_vv_uranus_bigtts

# ============================================================
# 数据库
# ============================================================
# 不设则用下面的默认值（本地开发口令，上服务器前必须改）
DB_URL=postgresql://postgres:chattertot_dev_pw@localhost:5432/chattertot
