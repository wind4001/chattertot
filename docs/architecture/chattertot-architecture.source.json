  "cards": [
    {
      "dot": "cyan",
      "title": "实时语音链路",
      "items": [
        "后端进程内做 VAD：RMS 阈值 300，静音 800ms 判停（EOT）",
        "单轮音频缓存上限 10s；活跃态静默 30s 回待机",
        "TTS 走 SSE 流式，前端按 24kHz 时间线无缝调度播放"
      ]
    },
    {
      "dot": "violet",
      "title": "唤醒与声纹",
      "items": [
        "待机态由 SANM KWS 检测「小云小云」，命中即转活跃",
        "AI 播放中说唤醒词可打断：取消当前轮任务并停播",
        "声纹每轮自成一份：唤醒句或首句确立，静默超时释放，不落库",
        "余弦相似度阈值 0.5，低于则视为旁人插话并忽略"
      ]
    },
    {
      "dot": "emerald",
      "title": "两层记忆",
      "items": [
        "短期：messages 表，最近 20 条进 LLM 上下文",
        "长期：profile.facts 注入 system prompt，靠 last_message_id 水位线增量摘要",
        "会话结束（静默超时或断连）触发摘要；当前全局单流，无用户身份"
      ]
    },
    {
      "dot": "amber",
      "title": "部署事实",
      "items": [
        "docker-compose 只含 ASR 容器与数据库，后端跑在宿主机",
        "ASR 容器一容器三进程：funasr-server :8000 / 声纹 :8001 / KWS :8002",
        "前端静态文件由后端直接托管，无独立前端服务"
      ]
    }
  ]
